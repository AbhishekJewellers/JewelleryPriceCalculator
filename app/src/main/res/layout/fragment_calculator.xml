<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/staleWarningButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stale_warning_desc"
            android:src="@drawable/ic_stale_warning"
            android:visibility="gone" />

        <!-- Table 1: Rate and Weight (Full Width) -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="2">

            <!-- Rate Row -->
            <TableRow>
                <Spinner
                    android:id="@+id/materialTypeSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:entries="@array/materialType"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/app_currency"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <EditText
                    android:id="@+id/rateInput"
                    android:layout_width="0dp"
                    android:minHeight="48dp"
                    android:hint="@string/default_decimal_value"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/app_weight_unit"
                    android:textStyle="bold" />
            </TableRow>

            <!-- Weight Row -->
            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/label_weight"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:text=""
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <EditText
                    android:id="@+id/weightInput"
                    android:layout_width="0dp"
                    android:minHeight="48dp"
                    android:hint="@string/default_decimal_value"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/app_weight"
                    android:textStyle="bold" />
            </TableRow>
        </TableLayout>

        <!-- 3rd Row Onwards: Two side-by-side Tables for Center Alignment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Left Part: Labels and first half inputs -->
            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stretchColumns="2">

                <!-- Making Row (Left) -->
                <TableRow>
                    <TextView
                        android:id="@+id/makingLabel"
                        android:layout_width="wrap_content"
                        android:text="@string/label_making"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text=""
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/makingInputPercentage"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:hint="@string/default_decimal_value"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="10" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_percent"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Charge Row (Left) -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/label_charge"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/app_currency"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/chargeInputAmountPerUnitWeight"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:text="@string/default_decimal_value"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="10" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/app_weight_unit"
                        android:textStyle="bold" />
                </TableRow>

                <!-- CGST Row (Left) -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/label_cgst"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text=""
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/cgstRateInput"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:text="@string/default_tax_rate" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_percent"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>

            <!-- Right Part: Symbols/SGST and second half inputs -->
            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stretchColumns="2">

                <!-- Making Row (Right) -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_equals"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                    <TextView
                        android:id="@+id/makingCurrencyLabel"
                        android:layout_width="wrap_content"
                        android:text="@string/app_currency"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/makingInputAmountPerUnitWeight"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:hint="@string/default_decimal_value"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="10" />
                    <TextView
                        android:id="@+id/makingUnitLabel"
                        android:layout_width="wrap_content"
                        android:text="@string/app_weight_unit"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Charge Row (Right) -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_plus"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/app_currency"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/chargeInputAmountTotal"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:text="@string/default_decimal_value"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="10" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="" />
                </TableRow>

                <!-- SGST Row (Right) -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_plus"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/label_sgst"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <EditText
                        android:id="@+id/sgstRateInput"
                        android:layout_width="0dp"
                        android:minHeight="48dp"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:text="@string/default_tax_rate" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/symbol_percent"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <Button
            android:id="@+id/button_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/light_gray"
            android:enabled="false"
            android:text="@string/btn_submit" />

        <!-- Output Section -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow>
                <TextView
                    android:id="@+id/materialAmountLabel"
                    android:layout_width="wrap_content"
                    android:text="@string/label_material_amount" />
                <TextView
                    android:id="@+id/materialAmountOutput"
                    android:layout_width="wrap_content"
                    android:gravity="end" />
            </TableRow>

            <TableRow>
                <TextView
                    android:id="@+id/makingAmountTotalLabel"
                    android:layout_width="wrap_content"
                    android:text="@string/label_total_making" />
                <TextView
                    android:id="@+id/makingAmountTotalOutput"
                    android:layout_width="wrap_content"
                    android:gravity="end" />
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/label_taxable_amount"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/taxableAmountOutput"
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/label_cgst" />
                <TextView
                    android:id="@+id/cgstValueOutput"
                    android:layout_width="wrap_content"
                    android:gravity="end" />
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/label_sgst" />
                <TextView
                    android:id="@+id/sgstValueOutput"
                    android:layout_width="wrap_content"
                    android:gravity="end" />
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/label_total_amount"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/totalAmountOutput"
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</ScrollView>
